# ⚠️  DO NOT COMMIT REAL CREDENTIALS — this is a template file only.
#
# Copy this file to secret-patch.yaml (gitignored), fill in real values,
# then apply out-of-band:
#   cp secret-patch.yaml.example secret-patch.yaml
#   # edit secret-patch.yaml — replace <PASSWORD> and your-postgres-host
#   kubectl apply -f deploy/overlays/postgres/secret-patch.yaml -n agentpulse
#   kubectl apply -k deploy/overlays/postgres/
#
# secret-patch.yaml is listed in .gitignore to prevent accidental credential commit.
# NEVER run `git add deploy/overlays/postgres/secret-patch.yaml` or `git commit -a`
# after filling in real values — git history is public.
apiVersion: v1
kind: Secret
metadata:
  name: agentpulse-secrets
  namespace: agentpulse
type: Opaque
stringData:
  # Set DATABASE_URL to your Postgres connection string.
  # Replace <PASSWORD> and your-postgres-host with real values.
  # The app runs Drizzle migrations on boot using this URL.
  # Add sslmode=require (or stronger) for connections outside a trusted local network.
  # See H1 note in CLAUDE.md: postgres-js defaults to plaintext (ssl: false).
  #
  # Example (standard Postgres with TLS):
  #   DATABASE_URL: "postgres://agentpulse:<PASSWORD>@your-postgres-host:5432/agentpulse?sslmode=require"
  #
  # Create the DB first:
  #   psql -h your-postgres-host -U psadmin -c "CREATE USER agentpulse WITH PASSWORD '<password>';"
  #   psql -h your-postgres-host -U psadmin -c "CREATE DATABASE agentpulse OWNER agentpulse ENCODING 'UTF8' LC_COLLATE 'C' LC_CTYPE 'C' TEMPLATE template0;"
  DATABASE_URL: "postgres://agentpulse:<PASSWORD>@your-postgres-host:5432/agentpulse?sslmode=require"

  # Postgres connection pool size. Tune based on max_connections and replica count.
  AGENTPULSE_PG_POOL_MAX: "10"

  # Fill in the remaining keys from 01-secret-template.yaml as needed.
  AGENTPULSE_INITIAL_API_KEY: ""
  AGENTPULSE_AUTHENTIK_TRUST_SECRET: ""
