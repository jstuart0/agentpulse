# Exclude development/ops artifacts that have no place in the runner image.
# The image needs: compiled server, web build, drizzle SQL+JSON migration files.
# It does NOT need: source schema TS files, local configs, secrets, git history,
# or the thoughts/ research directory.

.git/
node_modules/

# Research / planning — not needed at runtime
thoughts/

# Kubernetes deployment manifests — not part of the app bundle.
# Exception: the backup-sidecar Dockerfile (deploy/k8s/Dockerfile.backup) needs
# the run-backup.sh and retention.sh scripts that live alongside it. Without
# this exception, `scripts/build-and-push.sh` fails on the backup image with
# "COPY: file not found".
deploy/
!deploy/k8s/scripts/

# Secret templates — never copy secret material into the image layer
secrets/

# Env files — runtime values are injected via Kubernetes secrets / env vars
*.env
.env.*
.env

# Drizzle TypeScript source schema files — only the compiled SQL+JSON migration
# outputs (drizzle/sqlite/*.sql, drizzle/sqlite/meta/*.json,
# drizzle/postgres/*.sql, drizzle/postgres/meta/*.json) are needed at runtime.
drizzle/schema.*.ts

# Hook-payload test fixtures (agent-CLI spike captures) — dev/test-only JSON,
# never read at runtime. .dockerignore governs the build CONTEXT, i.e. the
# builder stage's own `COPY . .` from the host; it does not special-case a
# later `COPY --from=builder`, but since the builder is the only source for
# the runner's `COPY --from=builder /app/src/server ./src/server`
# (Dockerfile:37), excluding this here means it's never present in *any*
# stage's filesystem, so the runner image can't inherit it either. Neither
# `bun run build` (the builder stage's only RUN step) nor CI's `bun test`
# (which runs natively on the runner, not inside a Docker stage) touch this
# directory, so excluding it from the build context has no effect on either.
src/**/__fixtures__/
