	"deliberateDifferences": [
		{
			"id": "k8s-secret-data-token",
			"text": "data:\n  token: dGhpc2lzbm90YXNlY3JldGF0YWxsb2s=",
			"expected": "data:\n  token: [REDACTED]",
			"why": "a Kubernetes Secret's data value is a secret; the old rules had no YAML rule"
		},
		{
			"id": "curl-user-variables",
			"text": "curl -u $USER:$PASS https://example.com/x",
			"expected": "curl -u $USER:[REDACTED] https://example.com/x",
			"why": "curl -u name:secret; variable references are masked too since a literal cannot be told from one"
		},
		{
			"id": "env-pass-keyword",
			"text": "export DB_PASS=letmein99",
			"expected": "export DB_PASS= [REDACTED]",
			"why": "PASS is a new env keyword"
		},
		{
			"id": "cli-api-key-prose",
			"text": "auth is enabled and no --api-key was provided",
			"expected": "auth is enabled and no --api-key [REDACTED] provided",
			"why": "ACCEPTED over-match: prose after a secret flag is read as its value"
		},
		{
			"id": "json-token-value",
			"text": "{\"accessToken\":\"abcdef123456\"}",
			"expected": "{\"accessToken\": \"[REDACTED]\"}",
			"why": "camelCase JSON keys are covered; the old rules had no JSON rule"
		}
	]
}
